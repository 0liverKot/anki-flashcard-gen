#model-container {
    border: solid hsl(0, 0%, 20%);
    padding: 2
}

#user-container {
    border: solid hsl(0, 0%, 20%);
    height: auto
}

#loading {
    width: 5%;
    height: 5%;
    margin-bottom: 2
}

.response {
    margin-bottom: 2
}

.prompt {
    margin-bottom: 2;
    border: solid hsl(0, 0%, 10%);
    background: hsl(0, 0%, 10%);
    width: 100%
}

.error {
    margin-bottom: 2;
    border: solid none;
    width: 100% 
}

#model-container {
    border: solid hsl(0, 0%, 20%);
    padding: 2
}

#user-container {
    border: solid hsl(0, 0%, 20%);
    height: auto
}

#loading {
    width: 5%;
    height: 5%;
    margin-bottom: 2
}

.response {
    margin-bottom: 2
}

.model-text {
    margin-bottom: 2
}

.prompt {
    margin-bottom: 2;
    border: solid hsl(0, 0%, 10%);
    background: hsl(0, 0%, 10%);
    width: 100%
}

.error {
    margin-bottom: 2;
    border: solid none;
    width: 100% 
}

.approval-option-button {
    width: 100%;
    background: hsl(0, 0%, 10%);
    border: none;
    text-align: left;
    content-align: left middle;
}

.approval-option-button:focus,
.approval-option-button:focus:hover {
    background: hsl(0, 0%, 20%);
    background-tint: transparent;
    border: none;
    text-style: bold;
}

.proposal-text-area {
    height: 3;
    min-height: 3;
    max-height: 3;
    margin-bottom: 1;
    pointer: default;
}

.proposal-text-area:focus {
    border: tall transparent;
    background-tint: transparent;
}

.proposal-text-area .text-area--cursor-line {
    background: transparent;
}

.proposal-label {
    color: hsl(0, 0%, 70%)
}

.source-validation-label {
    margin-top: 1;
    color: hsl(0, 0%, 60%)
}
